	<item>
		<title><![CDATA[Home]]></title>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<content:encoded><![CDATA[<!-- wp:heading {"level":2} -->
<h2 class="wp-block-heading">Welcome to the UC Santa Cruz Playground</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>This is sample content for previewing the UCSC 2022 theme and UCSC plugins. Every word here is placeholder text, so edit or delete anything you like. Changes stay in your browser and disappear when you close the tab.</p>
<!-- /wp:paragraph -->

<!-- wp:buttons -->
<div class="wp-block-buttons"><!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/about/">About this department</a></div>
<!-- /wp:button -->

<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/campus-news/">Latest news</a></div>
<!-- /wp:button --></div>
<!-- /wp:buttons -->

<!-- wp:columns -->
<div class="wp-block-columns"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Academics</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>A sample column describing degree programs, with a link to the <a href="/academics/">Academics</a> page.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Research</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>A sample column highlighting research areas, labs and centers.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column -->

<!-- wp:column -->
<div class="wp-block-column"><!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Get in touch</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>A sample column pointing visitors to the <a href="/contact/">Contact</a> page.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:heading {"level":2} -->
<h2 class="wp-block-heading">Recent news</h2>
<!-- /wp:heading -->

<!-- wp:latest-posts {"postsToShow":3,"displayPostDate":true,"displayPostContent":true,"excerptLength":25} /-->]]></content:encoded>
