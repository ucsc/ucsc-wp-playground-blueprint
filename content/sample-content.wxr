		<dc:creator><![CDATA[admin]]></dc:creator>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>A sample parent page for degree programs. Its child page shows how the theme handles page hierarchy.</p>
<!-- /wp:paragraph -->

<!-- wp:table -->
<figure class="wp-block-table"><table><thead><tr><th>Program</th><th>Degree</th><th>Format</th></tr></thead><tbody><tr><td>Sample Program A</td><td>B.A.</td><td>In person</td></tr><tr><td>Sample Program B</td><td>B.S.</td><td>In person</td></tr><tr><td>Sample Program C</td><td>M.S.</td><td>Hybrid</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:paragraph -->
<p>See <a href="/academics/undergraduate-programs/">Undergraduate Programs</a> for a sample child page.</p>
<!-- /wp:paragraph -->]]></content:encoded>
